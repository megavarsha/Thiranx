#include <iostream>
#include <fstream>
#include <cstring>

using namespace std;

class Book {
private:
    int bookID;
    char title[50];
    char author[50];
    bool issued;

public:
    // Add book details
    void addBook() {
        cout << "Enter Book ID: ";
        cin >> bookID;

        cin.ignore();

        cout << "Enter Book Title: ";
        cin.getline(title, 50);

        cout << "Enter Author Name: ";
        cin.getline(author, 50);

        issued = false;
    }

    // Display book details
    void displayBook() const {
        cout << "\nBook ID     : " << bookID;
        cout << "\nTitle       : " << title;
        cout << "\nAuthor      : " << author;
        cout << "\nStatus      : "
             << (issued ? "Issued" : "Available") << endl;
    }

    // Getters
    int getBookID() const {
        return bookID;
    }

    const char* getTitle() const {
        return title;
    }

    const char* getAuthor() const {
        return author;
    }

    bool isIssued() const {
        return issued;
    }

    // Issue book
    void issueBook() {
        if (!issued) {
            issued = true;
            cout << "Book Issued Successfully!\n";
        } else {
            cout << "Book is Already Issued!\n";
        }
    }

    // Return book
    void returnBook() {
        if (issued) {
            issued = false;
            cout << "Book Returned Successfully!\n";
        } else {
            cout << "Book was Not Issued!\n";
        }
    }
};

// Add new book
void addNewBook() {
    Book b;

    ofstream outFile("library.dat", ios::binary | ios::app);

    b.addBook();
    outFile.write((char*)&b, sizeof(b));

    outFile.close();

    cout << "Book Added Successfully!\n";
}

// Display all books
void displayAllBooks() {
    Book b;

    ifstream inFile("library.dat", ios::binary);

    while (inFile.read((char*)&b, sizeof(b))) {
        b.displayBook();
        cout << "--------------------------\n";
    }

    inFile.close();
}

// Search by title
void searchByTitle() {
    char searchTitle[50];
    bool found = false;
    Book b;

    cin.ignore();

    cout << "Enter Book Title to Search: ";
    cin.getline(searchTitle, 50);

    ifstream inFile("library.dat", ios::binary);

    while (inFile.read((char*)&b, sizeof(b))) {
        if (strcmp(b.getTitle(), searchTitle) == 0) {
            b.displayBook();
            found = true;
        }
    }

    inFile.close();

    if (!found)
        cout << "Book Not Found!\n";
}

// Search by author
void searchByAuthor() {
    char searchAuthor[50];
    bool found = false;
    Book b;

    cin.ignore();

    cout << "Enter Author Name to Search: ";
    cin.getline(searchAuthor, 50);

    ifstream inFile("library.dat", ios::binary);

    while (inFile.read((char*)&b, sizeof(b))) {
        if (strcmp(b.getAuthor(), searchAuthor) == 0) {
            b.displayBook();
            found = true;
        }
    }

    inFile.close();

    if (!found)
        cout << "Author Not Found!\n";
}

// Issue a book
void issueBook() {
    int id;
    bool found = false;
    Book b;

    cout << "Enter Book ID to Issue: ";
    cin >> id;

    fstream file("library.dat", ios::binary | ios::in | ios::out);

    while (file.read((char*)&b, sizeof(b))) {
        if (b.getBookID() == id) {

            b.issueBook();

            file.seekp(-sizeof(b), ios::cur);
            file.write((char*)&b, sizeof(b));

            found = true;
            break;
        }
    }

    file.close();

    if (!found)
        cout << "Book Not Found!\n";
}

// Return a book
void returnBook() {
    int id;
    bool found = false;
    Book b;

    cout << "Enter Book ID to Return: ";
    cin >> id;

    fstream file("library.dat", ios::binary | ios::in | ios::out);

    while (file.read((char*)&b, sizeof(b))) {
        if (b.getBookID() == id) {

            b.returnBook();

            file.seekp(-sizeof(b), ios::cur);
            file.write((char*)&b, sizeof(b));

            found = true;
            break;
        }
    }

    file.close();

    if (!found)
        cout << "Book Not Found!\n";
}

// Main menu
int main() {
    int choice;

    do {
        cout << "\n========== LIBRARY MANAGEMENT SYSTEM ==========\n";
        cout << "1. Add New Book\n";
        cout << "2. Display All Books\n";
        cout << "3. Search Book by Title\n";
        cout << "4. Search Book by Author\n";
        cout << "5. Issue Book\n";
        cout << "6. Return Book\n";
        cout << "7. Exit\n";

        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) {

            case 1:
                addNewBook();
                break;

            case 2:
                displayAllBooks();
                break;

            case 3:
                searchByTitle();
                break;

            case 4:
                searchByAuthor();
                break;

            case 5:
                issueBook();
                break;

            case 6:
                returnBook();
                break;

            case 7:
                cout << "Exiting Library System...\n";
                break;

            default:
                cout << "Invalid Choice!\n";
        }

    } while (choice != 7);

    return 0;
}
